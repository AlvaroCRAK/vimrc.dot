
" Configuración básica para programación competitiva (ICPC) con tema oscuro manual

" Ajustes generales (se mantienen iguales)
set nocompatible
syntax enable
set number
set relativenumber
set cursorline
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent
set nowrap
set showmatch

" Tema oscuro - Dojo Nocturno
highlight clear
set background=dark
syntax reset

" Paleta principal (Tinta sobre papel washi oscuro)
highlight Normal       ctermfg=253     ctermbg=234     " Texto gris claro sobre fondo oscuro
highlight LineNr       ctermfg=242     ctermbg=235     " Números gris oscuro
highlight CursorLineNr ctermfg=214     cterm=bold      " Número actual en amarillo dorado
highlight CursorLine   ctermbg=236     cterm=none      " Línea actual con tono más claro

" Elementos de sintaxis (Tinta de caligrafía)
highlight Comment      ctermfg=244                     " Comentarios gris pizarra
highlight Constant     ctermfg=210                     " Constantes rojo suave
highlight Identifier   ctermfg=111                     " Identificadores azul cielo
highlight Statement    ctermfg=179     cterm=bold      " Palabras clave amarillo oscuro
highlight PreProc      ctermfg=183                     " Preprocesador lila
highlight Type         ctermfg=114                     " Tipos verde menta
highlight Special      ctermfg=208                     " Caracteres especiales naranja
highlight String       ctermfg=108                     " Strings verde musgo
highlight Number       ctermfg=180                     " Números melocotón
highlight MatchParen   ctermfg=255     ctermbg=33      " Paréntesis coincidentes azul brillante

" Interfaz (Elementos de bambú negro)
highlight Search       ctermfg=234     ctermbg=228     " Búsqueda amarillo brillante
highlight Visual                       ctermbg=239     " Selección gris medio
highlight Error        ctermfg=255     ctermbg=124     " Errores rojo intenso
highlight WarningMsg   ctermfg=208     ctermbg=234     " Advertencias naranja
highlight Folded       ctermfg=245     ctermbg=236     " Pliegues gris sobre oscuro

" Elementos estructurales
highlight Include      ctermfg=174                     " #includes rojo claro
highlight StorageClass ctermfg=179                     " Tipos de almacenamiento dorado
highlight Operator     ctermfg=208                     " Operadores naranja
highlight Function     ctermfg=117                     " Funciones azul claro

" Marcadores y ayudas
highlight Todo         ctermfg=234     ctermbg=228     " TODOs en amarillo sobre negro
highlight SpecialKey   ctermfg=239                     " Caracteres especiales gris oscuro
highlight NonText      ctermfg=238                     " Bordes gris muy oscuro
highlight Underlined   ctermfg=111     cterm=underline " Enlaces azul subrayado

" Efectos especiales (se mantienen iguales)
highlight! link Character   String
highlight! link Boolean     Constant
highlight! link Conditional Statement

" Elementos de interfaz adicionales
highlight ColorColumn  ctermbg=236
highlight Pmenu        ctermbg=238     ctermfg=253
highlight PmenuSel     ctermbg=111     ctermfg=235

" Configuraciones de búsqueda (se mantienen iguales)
set hlsearch
set ignorecase
set smartcase

" Rendimiento (se mantienen iguales)
set ttyfast
set lazyredraw

" Teclas rápidas personalizadas (se mantienen iguales)
map <F5> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r % && ./%:r<CR>
map <F6> :w<CR>:!./%:r<CR>
map <F9> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r %<CR>

" Ajustes de archivo (se mantienen iguales)
set encoding=utf-8
set fileformat=unix

" Eliminar espacios al final al guardar (se mantiene igual)
autocmd BufWritePre * :%s/\s\+$//e

" Deshabilitar archivos de respaldo (se mantiene igual)
set nobackup
set noswapfile
set nowritebackup

" Ayudas para depuración (se mantienen iguales)
set showcmd
set report=0
set errorbells
set visualbell

" Atajos de tiempo de competencia (se mantienen iguales)
inoremap <C-B> <Esc>:w<CR>a
nnoremap <C-S> :w<CR>
inoremap jj <Esc>

" Scroll y navegación (se mantienen iguales)
set scrolloff=10
set sidescrolloff=5
set sidescroll=1

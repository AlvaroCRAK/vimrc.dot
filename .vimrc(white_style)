" Configuración básica para programación competitiva (ICPC) con colores manuales

" Ajustes generales
set nocompatible
syntax enable
set number
set relativenumber
set cursorline
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent
set nowrap
set showmatch

" Configuración de colores estilo claro moderno

highlight clear
set background=light
syntax reset

" Paleta principal
highlight Normal       ctermfg=238     ctermbg=255     " Gris oscuro sobre blanco
highlight LineNr       ctermfg=242                     " Números de línea gris medio
highlight CursorLineNr ctermfg=94      cterm=bold      " Número línea actual azul oscuro
highlight CursorLine   ctermbg=253     cterm=none      " Línea actual gris claro

" Elementos de sintaxis
highlight Comment      ctermfg=242                     " Comentarios gris medio
highlight Constant     ctermfg=160                     " Constantes rojo intenso
highlight Identifier   ctermfg=25                      " Identificadores azul marino
highlight Statement    ctermfg=23      cterm=bold      " Palabras clave verde oscuro
highlight PreProc      ctermfg=90                      " Preprocesador púrpura
highlight Type         ctermfg=28                      " Tipos verde bosque
highlight Special      ctermfg=166                     " Caracteres especiales naranja oscuro
highlight String       ctermfg=136                     " Strings dorado
highlight Number       ctermfg=132                     " Números rojo vino
highlight MatchParen ctermfg=0  ctermbg=153            " Delimitadores coincidentes: texto negro sobre fondo azul claro para fácil identificación

" Interfaz
highlight Search       ctermfg=16      ctermbg=229     " Búsqueda amarillo claro
highlight Visual                       ctermbg=225     " Selección lila muy claro
highlight Error        ctermfg=160     ctermbg=224     " Errores rojo con fondo claro
highlight WarningMsg   ctermfg=94      ctermbg=223     " Advertencias naranja claro
highlight Folded       ctermfg=245     ctermbg=250     " Pliegues gris claro

" Ajustes especiales para C++
highlight Include      ctermfg=90                      " #includes púrpura oscuro
highlight StorageClass ctermfg=24                      " Tipos de almacenamiento azul
highlight Operator     ctermfg=23                      " Operadores verde oscuro



set hlsearch
set ignorecase
set smartcase

" Rendimiento
set ttyfast
set lazyredraw

" Teclas rápidas personalizadas
map <F5> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r % && ./%:r<CR>
map <F6> :w<CR>:!./%:r<CR>
map <F9> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r %<CR>

" Ajustes de archivo
set encoding=utf-8
set fileformat=unix

" Eliminar espacios al final al guardar
autocmd BufWritePre * :%s/\s\+$//e

" Deshabilitar archivos de respaldo
set nobackup
set noswapfile
set nowritebackup

" Ayudas para depuración
set showcmd
set report=0
set errorbells
set visualbell

" Atajos de tiempo de competencia
inoremap <C-B> <Esc>:w<CR>a
nnoremap <C-S> :w<CR>
inoremap jj <Esc>

" Scroll y navegación
set scrolloff=10                 " Margen vertical al desplazar
set sidescrolloff=5              " Margen horizontal al desplazar
set sidescroll=1                 " Desplazamiento horizontal suave


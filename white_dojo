" Configuración básica para programación competitiva (ICPC) con tema claro manual

" Ajustes generales
set nocompatible
syntax enable
set number
set relativenumber
set cursorline
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent
set nowrap
set showmatch

" Tema claro - Amanecer en el Dojo

highlight clear
set background=light
syntax reset

" Paleta principal (Papel de arroz iluminado)
highlight Normal       ctermfg=234     ctermbg=255     " Tinta negra sobre papel blanco
highlight LineNr       ctermfg=246     ctermbg=253     " Números gris claro
highlight CursorLineNr ctermfg=160     cterm=bold      " Número actual en rojo shinto
highlight CursorLine   ctermbg=253     cterm=none      " Línea actual como papel ligeramente sombreado

" Elementos de sintaxis (Tinta magistral)
highlight Comment      ctermfg=102                     " Comentarios gris pizarra
highlight Constant     ctermfg=124                     " Constantes rojo cereza
highlight Identifier   ctermfg=24                      " Identificadores azul profundo
highlight Statement    ctermfg=94      cterm=bold      " Palabras clave marrón oscuro
highlight PreProc      ctermfg=53                      " Preprocesador púrpura oscuro
highlight Type         ctermfg=28                      " Tipos verde bosque
highlight Special      ctermfg=166                     " Caracteres especiales naranja otoño
highlight String       ctermfg=28                      " Strings verde jade
highlight Number       ctermfg=130                     " Números marrón dorado
highlight MatchParen   ctermfg=255     ctermbg=21      " Paréntesis coincidentes en azul brillante

" Interfaz (Elementos de bambú)
highlight Search       ctermfg=255     ctermbg=208     " Búsqueda en naranja intenso
highlight Visual                       ctermbg=153     " Selección azul claro
highlight Error        ctermfg=255     ctermbg=124     " Errores rojo intenso
highlight WarningMsg   ctermfg=124     ctermbg=255     " Advertencias texto rojo
highlight Folded       ctermfg=242     ctermbg=254     " Pliegues gris sobre blanco

" Elementos estructurales
highlight Include      ctermfg=88                      " #includes rojo oscuro
highlight StorageClass ctermfg=94                      " Tipos de almacenamiento marrón
highlight Operator     ctermfg=166                     " Operadores naranja
highlight Function     ctermfg=24                      " Funciones azul marino

" Marcadores y ayudas
highlight Todo         ctermfg=255     ctermbg=160     " TODOs en rojo sobre blanco
highlight SpecialKey   ctermfg=245                     " Caracteres especiales gris
highlight NonText      ctermfg=250                     " Bordes gris claro
highlight Underlined   ctermfg=21      cterm=underline " Enlaces azul subrayado

" Efectos especiales
highlight! link Character   String
highlight! link Boolean     Constant
highlight! link Conditional Statement

" Elementos de interfaz adicionales
highlight ColorColumn  ctermbg=253
highlight Pmenu        ctermbg=255     ctermfg=240
highlight PmenuSel     ctermbg=24      ctermfg=255

" Configuraciones de búsqueda
set hlsearch
set ignorecase
set smartcase

" Rendimiento
set ttyfast
set lazyredraw

" Teclas rápidas personalizadas
map <F5> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r % && ./%:r<CR>
map <F6> :w<CR>:!./%:r<CR>
map <F9> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r %<CR>

" Ajustes de archivo
set encoding=utf-8
set fileformat=unix

" Eliminar espacios al final al guardar
autocmd BufWritePre * :%s/\s\+$//e

" Deshabilitar archivos de respaldo
set nobackup
set noswapfile
set nowritebackup

" Ayudas para depuración
set showcmd
set report=0
set errorbells
set visualbell

" Atajos de tiempo de competencia
inoremap <C-B> <Esc>:w<CR>a
nnoremap <C-S> :w<CR>
inoremap jj <Esc>

" Scroll y navegación
set scrolloff=10                 " Margen vertical al desplazar
set sidescrolloff=5              " Margen horizontal al desplazar
set sidescroll=1                 " Desplazamiento horizontal suave

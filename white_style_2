" Configuración básica para programación competitiva (ICPC) con colores manuales

" Ajustes generales
set nocompatible
syntax enable
set number
set relativenumber
set cursorline
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set smartindent
set nowrap
set showmatch

" Configuración de colores estilo claro moderno

highlight clear
set background=light
syntax reset

" Paleta principal
highlight Normal       ctermfg=236     ctermbg=255     " Texto gris oscuro sobre fondo blanco suave
highlight LineNr       ctermfg=242                     " Números de línea gris medio
highlight CursorLineNr ctermfg=21      cterm=bold      " Número línea actual azul intenso
highlight CursorLine   ctermbg=254     cterm=none      " Línea actual blanco ligeramente grisáceo

" Elementos de sintaxis
highlight Comment      ctermfg=102                     " Comentarios gris azulado
highlight Constant     ctermfg=160                     " Constantes rojo fuerte
highlight Identifier   ctermfg=25                      " Identificadores azul real
highlight Statement    ctermfg=90      cterm=bold      " Palabras clave púrpura
highlight PreProc      ctermfg=88                      " Preprocesador rojo oscuro
highlight Type         ctermfg=28                      " Tipos verde oscuro
highlight Special      ctermfg=166                     " Caracteres especiales naranja oscuro
highlight String       ctermfg=30                      " Strings verde azulado
highlight Number       ctermfg=124                     " Números rojo intenso
highlight MatchParen   ctermfg=255     ctermbg=21      " Paréntesis fondo azul

" Interfaz
highlight Search       ctermfg=255     ctermbg=208     " Búsqueda naranja brillante
highlight Visual                       ctermbg=153     " Selección azul claro
highlight Error        ctermfg=255     ctermbg=124     " Errores rojo sobre blanco
highlight WarningMsg   ctermfg=124     ctermbg=230     " Advertencias fondo amarillo claro
highlight Folded       ctermfg=242     ctermbg=254     " Pliegues gris claro

" Ajustes especiales para C++
highlight Include      ctermfg=126                     " #includes magenta
highlight StorageClass ctermfg=94                      " Tipos de almacenamiento marrón
highlight Operator     ctermfg=202                     " Operadores naranja brillante

" Mantener el resto de la configuración original...
" Elementos adicionales
highlight NonText      ctermfg=238                     " Caracteres no-texto
highlight Todo         ctermfg=196     ctermbg=234     " TODOs destacados
highlight Underlined   ctermfg=111     cterm=underline " URLs/enlaces

set hlsearch
set ignorecase
set smartcase

" Rendimiento
set ttyfast
set lazyredraw

" Teclas rápidas personalizadas
map <F5> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r % && ./%:r<CR>
map <F6> :w<CR>:!./%:r<CR>
map <F9> :w<CR>:!g++ -std=c++11 -Wall -O2 -o %:r %<CR>

" Ajustes de archivo
set encoding=utf-8
set fileformat=unix

" Eliminar espacios al final al guardar
autocmd BufWritePre * :%s/\s\+$//e

" Deshabilitar archivos de respaldo
set nobackup
set noswapfile
set nowritebackup

" Ayudas para depuración
set showcmd
set report=0
set errorbells
set visualbell

" Atajos de tiempo de competencia
inoremap <C-B> <Esc>:w<CR>a
nnoremap <C-S> :w<CR>
inoremap jj <Esc>

" Scroll y navegación
set scrolloff=10                 " Margen vertical al desplazar
set sidescrolloff=5              " Margen horizontal al desplazar
set sidescroll=1                 " Desplazamiento horizontal suave

